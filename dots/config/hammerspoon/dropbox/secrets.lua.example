-- Create an app at https://www.dropbox.com/developers/apps with scopes
-- sharing.write and files.metadata.read, then generate a long-lived refresh
-- token for it (not a short-lived access token — those expire in ~4 hours).
return {
  app_key = "",
  app_secret = "",
  refresh_token = "",
}
